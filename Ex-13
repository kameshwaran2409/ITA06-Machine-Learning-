import random

random.seed(42)

cars = []

brands = ["Toyota", "Honda", "BMW"]

for i in range(50):
    brand = random.choice(brands)
    year = random.randint(2010, 2025)
    mileage = random.randint(10000, 150000)

    price = (year - 2010) * 50000 - mileage * 0.5

    if brand == "BMW":
        price += 500000
    elif brand == "Honda":
        price += 200000

    price += random.randint(-50000, 50000)

    cars.append([brand, year, mileage, int(price)])

print("-" * 40)
print("Brand\tYear\tMileage\tPrice")

for car in cars[:5]:
    print(car[0], "\t", car[1], "\t", car[2], "\t", car[3])

