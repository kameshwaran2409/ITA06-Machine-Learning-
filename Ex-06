

import math
from collections import defaultdict, Counter


data = [
    [5.1, 3.5, 0],
    [4.9, 3.0, 0],
    [4.7, 3.2, 0],
    [4.6, 3.1, 0],
    [5.0, 3.6, 0],

    [6.2, 2.9, 1],
    [5.9, 3.0, 1],
    [6.0, 2.2, 1],
    [6.3, 2.7, 1],
    [6.1, 3.0, 1],

    [7.3, 3.0, 2],
    [6.7, 3.0, 2],
    [7.2, 3.2, 2],
    [6.5, 3.0, 2],
    [6.9, 3.1, 2],
]

train_data = data[:12]
test_data = data[12:]


def mean(values):
    return sum(values) / len(values)

def variance(values):
    m = mean(values)
    return sum((x - m) ** 2 for x in values) / len(values)

def gaussian_probability(x, m, var):
    if var == 0:
        var = 1e-9  
    exponent = math.exp(-((x - m) ** 2) / (2 * var))
    return (1 / (math.sqrt(2 * math.pi * var))) * exponent

classes = sorted(set(row[-1] for row in train_data))
class_counts = Counter(row[-1] for row in train_data)
total_train = len(train_data)


class_stats = {c: {} for c in classes}

for c in classes:

    rows = [row for row in train_data if row[-1] == c]

    num_features = len(rows[0]) - 1
    for i in range(num_features):
        values = [row[i] for row in rows]
        m = mean(values)
        var = variance(values)
        class_stats[c][i] = (m, var)


def predict(row):
    features = row[:-1]
    best_class = None
    best_log_prob = -float('inf')

    for c in classes:

        log_prob = math.log(class_counts[c] / total_train)

        num_features = len(features)
        for i in range(num_features):
            m, var = class_stats[c][i]
            prob = gaussian_probability(features[i], m, var)
            if prob == 0:
                prob = 1e-9
            log_prob += math.log(prob)

        if log_prob > best_log_prob:
            best_log_prob = log_prob
            best_class = c

    return best_class


y_true = []
y_pred = []

for row in test_data:
    true_label = row[-1]
    pred_label = predict(row)
    y_true.append(true_label)
    y_pred.append(pred_label)

correct = sum(1 for t, p in zip(y_true, y_pred) if t == p)
accuracy = correct / len(y_true)

print("Accuracy:", accuracy)

labels = sorted(set(y_true + y_pred))
label_to_idx = {l: i for i, l in enumerate(labels)}
n = len(labels)
cm = [[0] * n for _ in range(n)]

for t, p in zip(y_true, y_pred):
    i = label_to_idx[t]
    j = label_to_idx[p]
    cm[i][j] += 1

print("\nConfusion Matrix (rows: actual, cols: predicted):")
for row in cm:
    print(row)

print("\nLabels order:", labels)
