import random

random.seed(42)
data = [1, 2, 1.5, 2.5, 8, 9, 8.5, 9.5]

mean1 = 2
mean2 = 9

for iteration in range(5):

    cluster1 = []
    cluster2 = []

    for x in data:
        if abs(x - mean1) < abs(x - mean2):
            cluster1.append(x)
        else:
            cluster2.append(x)

    mean1 = sum(cluster1) / len(cluster1)
    mean2 = sum(cluster2) / len(cluster2)

    print("Iteration", iteration + 1)
    print("Mean 1:", round(mean1, 2))
    print("Mean 2:", round(mean2, 2))

print("\nFinal Clusters:")
print("Cluster 1:", cluster1)
print("Cluster 2:", cluster2)

print("\nFinal Means:")
print("Mean 1 =", mean1)
print("Mean 2 =", mean2)
