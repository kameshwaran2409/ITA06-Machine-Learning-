import random
import math
from collections import Counter

random.seed(42)

# Generate simple Iris-like dataset
data = []

for i in range(30):
    if i < 10:
        x = random.uniform(4, 5)
        y = random.uniform(2, 3)
        label = "Setosa"
    elif i < 20:
        x = random.uniform(5, 6.5)
        y = random.uniform(2, 3.5)
        label = "Versicolor"
    else:
        x = random.uniform(6, 7.5)
        y = random.uniform(3, 4)
        label = "Virginica"

    data.append([x, y, label])

test = [5.8, 3.0]
k = 3

distances = []

for row in data:
    distance = math.sqrt(
        (test[0] - row[0]) ** 2 +
        (test[1] - row[1]) ** 2
    )
    distances.append([distance, row[2]])

distances.sort()

neighbors = [distances[i][1] for i in range(k)]

prediction = Counter(neighbors).most_common(1)[0][0]

print("\nTest Flower:", test)
print("K Value:", k)
print("Nearest Neighbors:", neighbors)
print("\nPredicted Flower:", prediction)
